generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  passwordHash String?
  createdAt    DateTime     @default(now())
  invitations  Invitation[]
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Invitation {
  id                String    @id @default(cuid())
  userId            String
  slug              String?   @unique
  templateId        String
  status            String    @default("draft")
  paid              Boolean   @default(false)
  isDemo            Boolean   @default(false)
  guestManagerToken String?   @unique
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       InvitationContent?
  schedule      ScheduleItem[]
  gallery       GalleryPhoto[]
  wishes        Wish[]
  guestMedia    GuestMedia[]
  rsvps         Rsvp[]
  guests        Guest[]
  rsvpQuestions RsvpQuestion[]
  payments      Payment[]

  @@index([userId])
  @@index([isDemo])
}

model Payment {
  id                      String    @id @default(cuid())
  invitationId            String
  code                    String    @unique
  amount                  Int
  voucherCode             String?
  status                  String    @default("pending")
  provider                String    @default("casso")
  providerOrderCode       String?   @unique
  providerPaymentLinkId   String?   @unique
  providerCheckoutUrl     String?
  providerQrCode          String?
  providerBankBin         String?
  providerBankAccount     String?
  providerBankAccountName String?
  createdAt               DateTime  @default(now())
  paidAt                  DateTime?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([provider, status])
}

model Voucher {
  id        String    @id @default(cuid())
  code      String    @unique
  amountOff Int
  active    Boolean   @default(true)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model AppConfig {
  id                  String   @id @default("default")
  productPrice        Int      @default(150000)
  repeatCustomerPrice Int      @default(99000)
  updatedAt           DateTime @updatedAt
}

model InvitationContent {
  id           String @id @default(cuid())
  invitationId String @unique

  // theme
  primaryColor String  @default("#c8102e")
  fontFamily   String?
  assetFolder  String?
  music        String?

  // couple
  brideFullName   String  @default("")
  groomFullName   String  @default("")
  brideShortName  String  @default("")
  groomShortName  String  @default("")
  brideBirthOrder String  @default("")
  groomBirthOrder String  @default("")
  brideFirst      Boolean @default(true)
  date            String  @default("")
  time            String  @default("")
  ceremonyDate    String  @default("")
  ceremonyTime    String  @default("")
  ceremonyHeader  String  @default("")

  // families
  brideFather      String @default("")
  brideMother      String @default("")
  brideAddress     String @default("")
  groomFather      String @default("")
  groomMother      String @default("")
  groomAddress     String @default("")
  brideParentTitle String @default("")
  groomParentTitle String @default("")

  // venue
  address     String @default("")
  mapAddress  String @default("")
  banquetTime String @default("")

  // bank
  brideBankName      String @default("")
  brideAccountNumber String @default("")
  brideAccountName   String @default("")
  groomBankName      String @default("")
  groomAccountNumber String @default("")
  groomAccountName   String @default("")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

model ScheduleItem {
  id           String @id @default(cuid())
  invitationId String
  time         String
  label        String
  sortOrder    Int    @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model GalleryPhoto {
  id           String @id @default(cuid())
  invitationId String
  url          String
  sortOrder    Int    @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model Wish {
  id           String   @id @default(cuid())
  invitationId String
  name         String
  text         String
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model GuestMedia {
  id              String   @id @default(cuid())
  invitationId    String
  contributorName String
  storageKey      String   @unique
  originalName    String
  mimeType        String
  kind            String
  size            Int
  createdAt       DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
}

model Rsvp {
  id           String   @id @default(cuid())
  invitationId String
  guestId      String?
  name         String
  attending    Boolean  @default(true)
  guests       Int      @default(1)
  side         String?
  message      String?
  shuttle      Boolean  @default(false)
  dietary      String?
  songRequest  String?
  createdAt    DateTime @default(now())

  invitation Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  answers    RsvpAnswer[]

  @@index([invitationId])
  @@index([guestId])
}

model RsvpQuestion {
  id           String   @id @default(cuid())
  invitationId String
  label        String
  type         String   @default("text")
  required     Boolean  @default(false)
  options      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  invitation Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  answers    RsvpAnswer[]

  @@index([invitationId])
}

model RsvpAnswer {
  id         String @id @default(cuid())
  rsvpId     String
  questionId String
  value      String

  rsvp     Rsvp         @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  question RsvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([rsvpId, questionId])
  @@index([questionId])
}

model Track {
  id           String    @id
  title        String
  artist       String
  duration     Int
  url          String
  tags         String    @default("")
  status       String    @default("ready")
  youtubeUrl   String?
  submittedBy  String?
  errorMessage String?
  market       String    @default("all")
  reviewedAt   DateTime?
  addedAt      DateTime  @default(now())

  @@index([market])
  @@index([status])
}

model Guest {
  id           String   @id @default(cuid())
  invitationId String
  token        String   @unique
  name         String
  side         String?
  role         String?
  groupName    String?
  tableName    String?
  phone        String?
  email        String?
  greeting     String?
  maxGuests    Int      @default(1)
  giftAmount   Int?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvps      Rsvp[]

  @@index([invitationId])
}
