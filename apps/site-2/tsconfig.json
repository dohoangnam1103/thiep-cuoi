{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@messages/*": [
        "./messages/*"
      ],
      "@chungdoi/site-config": [
        "../../packages/site-config/src/index.ts"
      ],
      "@chungdoi/invitation-data": [
        "../../packages/invitation-data/src/signature-registry.ts"
      ],
      "@chungdoi/invitation-data/*": [
        "../../packages/invitation-data/src/*"
      ],
      "@chungdoi/invitation-core": [
        "../../packages/invitation-core/src/resolve-template.ts"
      ],
      "@chungdoi/invitation-core/*": [
        "../../packages/invitation-core/src/*"
      ],
      "@chungdoi/invitation-core/signature": [
        "../../packages/invitation-core/src/signature/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "messages/**/*.json",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
