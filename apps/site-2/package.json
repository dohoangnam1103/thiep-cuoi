{
  "name": "chungdoi-site-2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test \"src/**/*.test.{ts,tsx}\"",
    "test:boundary": "tsx --test ../../tests/site-2-source-boundary.test.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "build": "next build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@chungdoi/invitation-core": "0.1.0",
    "@chungdoi/invitation-data": "0.1.0",
    "@chungdoi/site-config": "0.1.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "jose": "^6.2.3",
    "next": "16.3.4",
    "next-intl": "^4.13.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
