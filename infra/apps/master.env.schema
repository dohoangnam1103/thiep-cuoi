# Required environment variable NAMES for the master app.
# Values live in the private server env file only — never in source.

# --- build input (baked into the image) ---
NEXT_PUBLIC_SITE_URL

# --- runtime ---
DATABASE_URL
SESSION_SECRET

# --- optional integrations (master only) ---
CASSO_WEBHOOK_TOKEN
NEXT_PUBLIC_GOOGLE_MAPS_KEY
EMAIL_LINK_SECRET
PAYOS_CLIENT_ID
PAYOS_API_KEY
PAYOS_CHECKSUM_KEY
AUTH_SECRET
