{
  "name": "ai-website-clone-template",
  "version": "0.3.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.4",
    "hono": "4.12.30",
    "postcss": "8.5.19",
    "sharp": "$sharp",
    "valibot": "1.4.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "ALLOW_INSECURE_SITE_URL=1 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check": "npm run lint && npm run typecheck && npm run typecheck:tests && npm run test:unit && npm run build:local",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:lightbox": "node scripts/verify-song-phung-lightbox.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/.report",
    "audit:assets": "node scripts/dedupe-public-assets.mjs",
    "beach:prepare-assets": "node scripts/prepare-beach-photoreal-assets.mjs",
    "screenshots:templates": "node scripts/capture-template-previews.mjs",
    "templates:register": "tsx scripts/register-template-manifests.ts",
    "templates:prepare-opening-assets": "tsx scripts/prepare-opening-assets.ts",
    "templates:validate-opening-assets": "tsx scripts/validate-opening-effect-assets.ts",
    "deploy": "./scripts/deploy-fast.sh",
    "deploy:smoke": "SMOKE_ONLY=1 ./scripts/deploy-fast.sh",
    "deploy:setup": "./scripts/setup-fast-deploy.sh",
    "deploy:legacy": "./scripts/deploy-minipc.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:tracks": "tsx prisma/seed-tracks.ts",
    "seed:demos": "tsx scripts/seed-demos.ts",
    "seed:demos:missing": "tsx scripts/seed-demos.ts --missing",
    "seed:demos:completed-missing": "tsx scripts/seed-demos.ts --missing --completed",
    "reminders:trial": "tsx scripts/send-trial-reminders.ts",
    "reconcile:payos": "tsx scripts/reconcile-payos.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "heic-decode": "^2.1.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.2",
    "ogl": "1.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "19.2.7",
    "react-select": "^5.10.2",
    "recharts": "3.8.0",
    "resend": "^6.18.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "16.2.11",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/heic-decode": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "playwright-core": "^1.61.1",
    "prisma": "^7.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
