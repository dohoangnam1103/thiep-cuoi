[Unit]
Description=Thiep Mung Online trial reminder emails
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/srv/thiepmungonline/LIVE

[Service]
Type=oneshot
Environment=APP_DIR=/srv/thiepmungonline
Environment=TZ=Asia/Ho_Chi_Minh
ExecStart=/usr/bin/bash /srv/thiepmungonline/ops/cron-hit-endpoint.sh /api/cron/trial-reminders
TimeoutStartSec=920
